# === Wajib (isi di Vercel > Settings > Environment Variables) ===
# Supabase: Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # service_role (RAHASIA, hanya dipakai server)
# Kunci untuk mengenkripsi API key AI di database (min 16 karakter acak, jangan diganti setelah dipakai)
ENCRYPTION_SECRET=
# Password untuk masuk ke website (sangat disarankan, supaya orang lain tidak bisa memakai API key-mu)
APP_PASSWORD=

# API key AI TIDAK diisi di sini: masukkan lewat halaman Settings di website.
